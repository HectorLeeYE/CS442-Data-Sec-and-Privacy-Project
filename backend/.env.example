# Copy to backend/.env and adjust. Every value here is a development default.

# Secret used to sign JWTs. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-insecure-secret-change-me
TOKEN_TTL_MINUTES=60

# SQLite file used by the demo. Relative paths resolve from the backend directory.
DATABASE_URL=sqlite:///./app.db

# Ciphertext backend. "stub" enforces policies but stores a base64 placeholder.
# The CP-ABE implementation will be registered here as a second value.
CRYPTO_BACKEND=stub

# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Expose the seeded sample accounts on the sign-in page. Turn off for anything real.
EXPOSE_DEMO_ACCOUNTS=true
DEMO_PASSWORD=demo1234

ENVIRONMENT=development
